{
  "name": "@n24q02m/hull",
  "version": "0.4.0",
  "description": "hull TypeScript core: MCP Streamable HTTP 2025-11-25 transport, OAuth 2.1 AS, lifecycle, install",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "streamable-http",
    "oauth21",
    "transport",
    "claude",
    "cursor",
    "copilot",
    "codex",
    "opencode"
  ],
  "author": {
    "name": "n24q02m",
    "url": "https://github.com/n24q02m"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n24q02m/hull.git",
    "directory": "packages/core-ts"
  },
  "homepage": "https://github.com/n24q02m/hull",
  "bugs": {
    "url": "https://github.com/n24q02m/hull/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./crypto": {
      "import": "./build/crypto/index.js",
      "types": "./build/crypto/index.d.ts"
    },
    "./storage": {
      "import": "./build/storage/index.js",
      "types": "./build/storage/index.d.ts"
    },
    "./schema": {
      "import": "./build/schema/types.js",
      "types": "./build/schema/types.d.ts"
    },
    "./transport": {
      "import": "./build/transport/index.js",
      "types": "./build/transport/index.d.ts"
    },
    "./token-auth": {
      "import": "./build/token-auth/index.js",
      "types": "./build/token-auth/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest --passWithNoTests",
    "test:coverage": "vitest --coverage --passWithNoTests",
    "check": "biome check . && bun run type-check",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "better-sqlite3": "^13.0.3",
    "env-paths": "^4.0.0",
    "jose": "^6.2.12",
    "smol-toml": "^1.9.0"
  },
  "trustedDependencies": [
    "better-sqlite3"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "bun@1.4.4"
}
